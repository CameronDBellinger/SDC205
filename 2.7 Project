print(f"\nHello, {userName}! Welcome to the guessing game.\n")

# GUESSING GAME
correctNumber = 5
userGuess = 0
guessCount = 0

userGuess = int(input("Guess a number between 1 and 10: "))
guessCount += 1

if userGuess > correctNumber:
    print("Your guess is too high.")
elif userGuess < correctNumber:
    print("Your guess is too low.")
else:
    print("You guessed correctly!")

print(f"It took you {guessCount} attempt(s) to guess.\n")

print("Output from the 'while' loop:")
x = correctNumber
counter = 0

while counter < 5:
    x += 1
    print(f"x incremented by 1 is {x}")
    counter += 1

# FOR LOOP
print("\nOutput from the 'for' loop:")
x = correctNumber

for i in range(5):
    x += 1
    print(f"x incremented by 1 is {x}")
