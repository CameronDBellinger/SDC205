import pandas as pd
import matplotlib.pyplot as plt


def main():


   students = ["John", "Mary", "Alex", "Sarah", "David",
               "Emily", "Chris", "Laura", "Brian", "Megan"]


   subjects = ["Math", "Science"]
   index = pd.MultiIndex.from_product([students, subjects],
                                      names=("Student", "Subject"))


   grades = {
       "Grade": [85, 90, 78, 88, 92, 95, 80, 84, 76, 89,
                 91, 87, 83, 79, 94, 90, 88, 82, 77, 85]
   }
   df = pd.DataFrame(grades, index=index)


   print(df)
  
#This one below
   subject_means = df.groupby("Subject").mean()
   print(subject_means)


   subject_means.plot(kind="bar", legend=False)
   plt.title("Average Grades by Subject")
   plt.xlabel("Subject")
   plt.ylabel("Average Grade")
   plt.xticks(rotation=0)
   plt.show()


main()
